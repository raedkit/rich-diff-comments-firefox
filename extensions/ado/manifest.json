{
  "manifest_version": 3,
  "name": "Markdown PR — Azure DevOps PR Comments",
  "version": "1.5.0",
  "description": "Comment on rendered Markdown in Azure DevOps PRs with inline threads, Changes, Outline, and keyboard navigation.",
  "author": "chienyuanchang",

  "homepage_url": "https://github.com/chienyuanchang/rich-diff-comments",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "host_permissions": [
    "https://dev.azure.com/*",
    "https://*.visualstudio.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "markdown-pr-ado@raedkit-fork",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://dev.azure.com/*/_git/*/pullrequest/*",
        "https://*.visualstudio.com/*/_git/*/pullrequest/*"
      ],
      "js": [
        "src/lib/textMatch.js",
        "src/lib/tableRows.js",
        "src/lib/markdownPreview.js",
        "src/lib/codeBlocks.js",
        "src/lib/sectionCollapse.js",
        "src/lib/sidebar.js",
        "src/lib/outline.js",
        "src/lib/changes.js",
        "src/lib/mentions.js",
        "src/lib/lineMap.js",
        "src/lib/responses.js",
        "src/adapters/ado.js",
        "content.js"
      ],
      "css": ["styles.css"],
      "run_at": "document_end",
      "world": "MAIN"
    }
  ]
}
